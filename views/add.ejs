<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Sidequest - Questify</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
<body>
    <%- include('navbar') %>

    <div class="container mt-4">
        <div class="row">
            <div class="col-md-8 mx-auto">
                <h1 class="mb-4">Create New Sidequest</h1>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <form method="POST" action="/add-sidequest" class="needs-validation">
                    
                    <div class="alert alert-info mb-4">
                        <strong>Creating quest for:</strong> <%= typeof userProfile !== 'undefined' ? userProfile.name : 'Unknown' %><br>
                        <small>Profile: <%= typeof userProfile !== 'undefined' ? userProfile.selfDescription : '' %></small><br>
                        <a href="/settings" class="alert-link text-decoration-none mt-2 d-inline-block">Edit Profile</a>
                    </div>
    

                    

                    <div class="mb-3">
                        <label for="feeling" class="form-label">How Are You Feeling Right Now? *</label>
                        <textarea class="form-control" id="feeling" name="feeling" rows="2" placeholder="e.g., Tired but motivated, feeling creative, need a break" required></textarea>
                        <small class="form-text text-muted">Your mood helps shape the sidequest.</small>
                    </div>

                    <div class="mb-3">
                        <label for="difficulty" class="form-label">Difficulty Level *</label>
                        <select class="form-select" id="difficulty" name="difficulty" required>
                            <option value="">-- Select Difficulty --</option>
                            <option value="Easy">Easy (5-10 minutes)</option>
                            <option value="Medium">Medium (15-30 minutes)</option>
                            <option value="Hard">Hard (30-60 minutes)</option>
                        </select>
                        <small class="form-text text-muted">This guides how our AI creates your sidequest. The timer will be estimated based on the activity generated.</small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            ✨ Generate My Sidequest
                        </button>
                        <a href="/" class="btn btn-secondary btn-lg">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
