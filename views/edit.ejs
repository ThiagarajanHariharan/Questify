<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Sidequest - Questify</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
<body>
    <%- include('navbar') %>

    <div class="container mt-4">
        <div class="row">
            <div class="col-md-8 mx-auto">
                <h1 class="mb-4">Edit Sidequest</h1>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <form method="POST" action="/edit/<%= sidequest.id %>" class="needs-validation">
                    
                    <div class="alert alert-info mb-4">
                        <strong>Quest belongs to:</strong> <%= sidequest.name %><br>
                        <small>Profile at creation: <%= sidequest.selfDescription %></small>
                    </div>
    

                    

                    <div class="mb-3">
                        <label for="feeling" class="form-label">How Are You Feeling? *</label>
                        <textarea class="form-control" id="feeling" name="feeling" rows="2" required><%= sidequest.feeling %></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="difficulty" class="form-label">Difficulty Level *</label>
                        <select class="form-select" id="difficulty" name="difficulty" required>
                            <option value="Easy" <% if (sidequest.difficulty === 'Easy') { %>selected<% } %>>Easy (5-10 minutes)</option>
                            <option value="Medium" <% if (sidequest.difficulty === 'Medium') { %>selected<% } %>>Medium (15-30 minutes)</option>
                            <option value="Hard" <% if (sidequest.difficulty === 'Hard') { %>selected<% } %>>Hard (30-60 minutes)</option>
                        </select>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="regenerate" name="regenerate">
                        <label class="form-check-label" for="regenerate">
                            ✨ Regenerate activity with new details (generates a new sidequest)
                        </label>
                    </div>

                    
                    <div class="alert alert-info">
                        <strong>Current Quest:</strong><br>
                        <%= sidequest.generatedActivity %>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">💾 Save Changes</button>
                        <a href="/sidequest/<%= sidequest.id %>" class="btn btn-secondary btn-lg">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
