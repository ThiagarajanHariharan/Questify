<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - Questify</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
<body>
    <%- include('navbar') %>

    <div class="container mt-4">
        <div class="row">
            <div class="col-md-8 mx-auto">
                <h1 class="mb-4">Profile Settings</h1>

                <% if (typeof success !== 'undefined' && success) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>
                
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <p class="text-muted mb-4">Set your profile once so our AI can personalize all your sidequests without asking every time.</p>
                        
                        <form method="POST" action="/settings" class="needs-validation">
                            <div class="mb-3">
                                <label for="name" class="form-label">Your Name/Nickname *</label>
                                <input type="text" class="form-control" id="name" name="name" value="<%= typeof userProfile !== 'undefined' ? userProfile.name : '' %>" placeholder="e.g., Alex" required>
                                <small class="form-text text-muted">How should we address you?</small>
                            </div>

                            <div class="mb-4">
                                <label for="selfDescription" class="form-label">Tell Us About Yourself *</label>
                                <textarea class="form-control" id="selfDescription" name="selfDescription" rows="3" placeholder="e.g., Student, enjoys coding and games, learning web development" required><%= typeof userProfile !== 'undefined' ? userProfile.selfDescription : '' %></textarea>
                                <small class="form-text text-muted">This helps our AI personalize your sidequests based on your interests.</small>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">
                                    💾 Save Settings
                                </button>
                                <a href="/" class="btn btn-outline-secondary">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
