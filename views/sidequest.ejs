<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= sidequest.name %>'s Sidequest</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <%- include('navbar') %>

    <div class="container mt-4">
        <div class="row">
            <div class="col-md-8 mx-auto">
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>
                
                <div class="card">
                    <div class="card-header bg-dark text-white">
                        <h2 class="mb-0"><%= sidequest.name %>'s Sidequest</h2>
                    </div>
                    <div class="card-body">
                        <!-- Metadata -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <p><strong>Status:</strong> 
                                    <% if (sidequest.status === 'completed') { %>
                                        <span class="badge bg-success">✓ Completed</span>
                                    <% } else { %>
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    <% } %>
                                </p>
                                <p><strong>Difficulty:</strong> 
                                    <span class="badge <%= sidequest.difficulty === 'Easy' ? 'bg-success' : sidequest.difficulty === 'Medium' ? 'bg-warning text-dark' : 'bg-danger' %>">
                                        <%= sidequest.difficulty %>
                                    </span>
                                </p>
                                <p><strong>Estimated Time:</strong> 
                                    <span class="badge bg-secondary" id="timeBadge">⏱ <%= sidequest.timer %></span>
                                </p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Feeling:</strong> <%= sidequest.feeling %></p>
                                <p><strong>About Them:</strong> <%= sidequest.selfDescription %></p>
                                <p><strong>Created:</strong> <%= new Date(sidequest.createdAt).toLocaleDateString() %></p>
                            </div>
                        </div>

                        <% if (sidequest.status === 'pending') { %>
                            <!-- Live Timer Display -->
                            <div class="mb-4 text-center p-4 rounded bg-light border border-info shadow-sm" id="timerBox">
                                <h5 class="text-info mb-2">⏱ Quest Timer</h5>
                                <h1 class="display-1 fw-bold text-dark font-monospace" id="countdownDisplay">--:--</h1>
                            </div>
                        <% } %>

                       
                        <div class="mb-4 p-3 bg-light rounded">
                            <h4>🎮 Your Sidequest</h4>
                            <p style="line-height: 1.8;"><%= sidequest.generatedActivity %></p>
                        </div>

                        <% if (sidequest.status === 'pending') { %>
                            
                            <div class="card border-success shadow-sm mb-4">
                                <div class="card-header bg-success text-white">
                                    <h5 class="mb-0">Prove Your Worth! (Photo Required)</h5>
                                </div>
                                <div class="card-body p-4">
                                    <p class="fw-bold mb-3">
                                        Upload a photo as proof that you completed this sidequest! Our AI Evaluator will analyze it.
                                    </p>
                                    
                                    <form id="completeForm" method="POST" action="/complete/<%= sidequest.id %>" enctype="multipart/form-data">
                                        <div class="mb-3">
                                            <input type="file" class="form-control" id="questProof" name="questProof" accept="image/*" required>
                                        </div>
                                        <div class="mb-3">
                                            <textarea class="form-control" id="userAnswer" name="userAnswer" rows="2" placeholder="Additional Comments (Optional)"></textarea>
                                        </div>
                                        <button type="button" class="btn btn-success w-100" onclick="showFeelingModal(event)">
                                            ✓ Submit & Verify
                                        </button>
                                    </form>
                                </div>
                            </div>
                        <% } %>

                        <% if (sidequest.status === 'completed') { %>
                            
                            <div class="mb-4 p-3 border border-success rounded bg-white shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="text-success mb-0">🏅 Quest Verification</h5>
                                    <% if (sidequest.rating) { %>
                                        <span class="fs-5"><%= sidequest.rating %></span>
                                    <% } %>
                                </div>
                                
                                <% if (sidequest.imagePath) { %>
                                    <div class="mb-3 text-center bg-light p-2 rounded border">
                                        <img src="<%= sidequest.imagePath %>" class="img-fluid rounded shadow-sm" style="max-height: 300px; object-fit: contain;" alt="Quest Proof">
                                    </div>
                                <% } %>

                                <% if (sidequest.userAnswer) { %>
                                    <p class="text-muted fst-italic mb-3">"<%= sidequest.userAnswer %>"</p>
                                <% } %>
                                
                                <% if (sidequest.feedback) { %>
                                    <div class="alert alert-info py-2 px-3 mb-3 border-0 bg-light">
                                        <strong>🤖 AI Evaluator says:</strong> <%= sidequest.feedback %>
                                    </div>
                                <% } %>

                                <% if (sidequest.postQuestFeeling) { %>
                                    <div class="alert alert-success py-2 px-3 mb-0 border-0 bg-light">
                                        <strong>💭 Your Feeling After Quest:</strong> <%= sidequest.postQuestFeeling %>
                                    </div>
                                <% } %>
                            </div>
                        <% } %>

                        
                        <div class="d-flex gap-2">
                            <a href="/edit/<%= sidequest.id %>" class="btn btn-warning">✏️ Edit</a>
                            
                            <form method="POST" action="/delete/<%= sidequest.id %>" 
                                  onsubmit="return confirm('Delete this sidequest?');" style="display: inline;">
                                <button type="submit" class="btn btn-danger">🗑️ Delete</button>
                            </form>
                            
                            <a href="/" class="btn btn-secondary">← Back to Dashboard</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Feeling Modal -->
    <div class="modal fade" id="feelingModal" tabindex="-1" backdrop="static" keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">How Do You Feel? 💭</h5>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-3">After completing this quest, how are you feeling?</p>
                    <textarea id="feelingResponse" class="form-control" rows="3" placeholder="e.g., Energized, Accomplished, Proud, Refreshed..." required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="resetModal()">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="submitWithFeeling()">Continue</button>
                </div>
            </div>
        </div>
    </div>
    
    <% if (sidequest.status === 'pending') { %>
    <script>
        // Modal functions
        function showFeelingModal(event) {
            event.preventDefault();
            const modal = new bootstrap.Modal(document.getElementById('feelingModal'));
            modal.show();
        }
        
        function resetModal() {
            document.getElementById('feelingResponse').value = '';
            const modal = bootstrap.Modal.getInstance(document.getElementById('feelingModal'));
            modal.hide();
        }
        
        function submitWithFeeling() {
            const feeling = document.getElementById('feelingResponse').value.trim();
            if (!feeling) {
                alert('Please tell us how you feel!');
                return;
            }
            
            // Add feeling to form data
            const form = document.getElementById('completeForm');
            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.name = 'postQuestFeeling';
            hiddenInput.value = feeling;
            form.appendChild(hiddenInput);
            
            // Submit the form
            form.submit();
        }
        
        
        const timeString = "<%= sidequest.timer %>";
        const match = timeString.match(/\d+/);
        let minutes = match ? parseInt(match[0]) : 15; 
        let totalSeconds = minutes * 60;
        
        const display = document.getElementById('countdownDisplay');
        const timerBox = document.getElementById('timerBox');
        
        function updateDisplay() {
            const m = Math.floor(totalSeconds / 60);
            const s = totalSeconds % 60;
            display.innerText = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
            
            if (totalSeconds <= 0) {
                clearInterval(interval);
                display.innerText = "Time's up!";
                display.classList.remove('text-dark');
                display.classList.add('text-danger');
                timerBox.classList.remove('border-info');
                timerBox.classList.add('border-danger');
            } else {
                totalSeconds--;
            }
        }
        
        updateDisplay(); 
        const interval = setInterval(updateDisplay, 1000);
    </script>
    <% } %>
</body>
</html>
